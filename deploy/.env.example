# À copier en /opt/cocoashield/.env sur le VPS, puis remplacer chaque valeur.

# Domaine public de l'application (DNS A pointé sur le VPS).
DOMAIN=app.example.com

# PostgreSQL (interne au réseau Docker, jamais exposé).
POSTGRES_DB=cocoashield
POSTGRES_USER=cocoashield
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Secret de signature des sessions — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire

# Tags d'images à déployer (rollback : fixer un SHA de commit précédent).
BACK_TAG=latest
WEB_TAG=latest
