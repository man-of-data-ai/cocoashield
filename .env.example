# Copier en `.env` à la racine pour `docker compose`.
# Ne jamais versionner le fichier `.env` lui-même.

# Base de données
DATABASE_NAME=cocoashield
DATABASE_USERNAME=cocoashield
DATABASE_PASSWORD=change-me
DATABASE_PORT=5432

REDIS_PORT=6379

# Authentification — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3002

# Port exposé par le front en production
WEB_PORT=3002
